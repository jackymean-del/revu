# Copy to .env (git-ignored). docker compose reads it for the api service.
# Local development uses the Clerk development instance shared with schedU
# (keys start with sk_test_ and pk_test_). Never put live keys here.
CLERK_SECRET_KEY=sk_test_replace_me
# Signing secret of the Clerk webhook endpoint (whsec_...). Without it the
# webhook answers 503. Clerk cannot reach localhost, so locally it is only
# needed when testing through a tunnel.
CLERK_WEBHOOK_SECRET=
# Verified email addresses that run the platform: the owner console, never an
# institution's content. Comma separated.
PLATFORM_OWNER_EMAILS=
