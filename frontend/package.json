{
  "name": "revu-frontend",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "typecheck": "tsc -b",
    "preview": "vite preview",
    "lint": "eslint src *.mts --max-warnings 0",
    "gen:api": "openapi-typescript ../contracts/openapi.yaml -o src/api/schema.gen.ts",
    "gen:terms": "node -e \"require('fs').copyFileSync('src/lib/terminology/presets.json','../backend/internal/terminology/presets.gen.json')\""
  },
  "dependencies": {
    "@clerk/react": "^6.18.4",
    "@tanstack/react-query": "^5.90.0",
    "@tanstack/react-router": "^1.170.46",
    "react": "^19.2.0",
    "react-dom": "^19.2.0"
  },
  "devDependencies": {
    "@eslint/js": "^9.30.0",
    "@tailwindcss/vite": "^4.3.3",
    "@types/node": "^24.0.0",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@vitejs/plugin-react": "^6.1.2",
    "eslint": "^9.30.0",
    "eslint-plugin-react-hooks": "^5.2.0",
    "eslint-plugin-react-refresh": "^0.4.20",
    "globals": "^16.3.0",
    "knip": "^6.44.1",
    "openapi-typescript": "^7.9.0",
    "tailwindcss": "^4.1.0",
    "tsx": "^4.20.0",
    "typescript": "^5.9.0",
    "typescript-eslint": "^8.40.0",
    "vite": "^8.3.5"
  }
}
